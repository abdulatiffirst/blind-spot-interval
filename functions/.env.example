APP_ORIGIN=http://localhost:5174
CALENDAR_REDIRECT_URI=http://localhost:5174/api/v1/calendar/callback
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET and TOKEN_ENCRYPTION_KEY belong in Secret Manager in production.
# For local Calendar development only, use ignored functions/.secret.local.
WEBHOOK_ORIGIN=
CALENDAR_WATCH_FALLBACK_MINUTES=60
# Set false during a topic index repair or a phased rollback.
TOPIC_INDEX_ENABLED=true

# Blind Spot Connect stays off unless explicitly enabled.
BLIND_SPOT_CONNECT_ENABLED=false
BLIND_SPOT_CONNECT_WRITES=false
BLIND_SPOT_CONNECT_ORIGIN=http://localhost:5174
# Public PKCE clients and exact callback URI allowlist for optional dynamic registration.
BLIND_SPOT_CONNECT_CLIENTS=[]
BLIND_SPOT_CONNECT_REGISTRATION_REDIRECTS=[]
