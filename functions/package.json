{
  "name": "functions",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "node build.mjs",
    "serve": "npm run build && node ../scripts/emulators.mjs emulators:start --only auth,firestore,functions,hosting",
    "gcp-build": "",
    "lint": "eslint src --config ../eslint.config.js",
    "build:watch": "node build.mjs --watch",
    "shell": "npm run build && firebase functions:shell --project demo-blind-spot-interval",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "express": "4.22.3",
    "firebase-admin": "14.5.1",
    "firebase-functions": "7.4.0",
    "luxon": "3.7.2",
    "ts-fsrs": "6.0.0",
    "zod": "4.6.7"
  }
}
