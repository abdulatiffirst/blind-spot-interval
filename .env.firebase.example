# Frontend public Firebase configuration (not OAuth client secrets)
VITE_BACKEND=firebase
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-blind-spot-interval
# Demo-only emulator API key; replace with Firebase web config for production.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-blind-spot-interval.firebaseapp.com
VITE_FIREBASE_APP_ID=
