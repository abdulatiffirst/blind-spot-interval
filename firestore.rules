rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  match /users/{uid} {
   allow read: if owner(uid);
   allow write: if false;
   match /{collection}/{id} {
    allow read: if owner(uid) && collection in ['preferences','topics','topicMaterials','tags','memoryStates','reviewHistory','reviewSchedules','calendarEvents','reviewCorrections'];
    allow write: if false;
   }
  }
  match /{document=**} { allow read, write: if false; }
 }
}
