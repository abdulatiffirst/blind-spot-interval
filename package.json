{
  "name": "blind-spot-interval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "dev": "npm run functions:build && concurrently -k \"npm:emulators\" \"npm:dev:web:firebase\" \"npm:firebase:worker\" \"npm:dev:functions\"",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts --host 0.0.0.0",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "db:migrate": "tsx packages/database/migrate.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run functions:build && vite build --config apps/web/vite.config.ts",
    "test": "npm run test:unit",
    "test:e2e": "npm run functions:build && node scripts/emulators.mjs emulators:exec --headless --only auth,firestore,functions \"playwright test --config playwright.firebase.config.ts\"",
    "lint": "eslint .",
    "start:api": "tsx apps/api/src/index.ts",
    "start:worker": "tsx apps/worker/src/index.ts",
    "dev:legacy": "concurrently -k \"npm:dev:api\" \"npm:dev:web:legacy\" \"npm:dev:worker\"",
    "dev:web:firebase": "vite --config apps/web/vite.config.ts --host 0.0.0.0 --port 5174 --strictPort",
    "functions:build": "npm run build -w functions",
    "emulators": "node scripts/emulators.mjs emulators:start --only auth,firestore,functions,hosting",
    "test:legacy": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:firebase": "npm run functions:build && node scripts/emulators.mjs emulators:exec --headless --only auth,firestore,functions \"vitest run --config vitest.firebase.config.ts\"",
    "emulators:prepare": "node scripts/prepare-firestore.mjs",
    "dev:web:legacy": "cross-env VITE_BACKEND=legacy vite --config apps/web/vite.config.ts --host 0.0.0.0",
    "test:e2e:legacy": "playwright test",
    "emulators:headless": "node scripts/emulators.mjs emulators:start --headless --only auth,firestore,functions,hosting",
    "dev:headless": "npm run functions:build && concurrently -k \"npm:emulators:headless\" \"npm:dev:web:firebase\" \"npm:firebase:worker\" \"npm:dev:functions\"",
    "firebase:migrate": "tsx scripts/migrate-postgres-to-firestore.ts",
    "test:e2e:firebase": "npm run functions:build && node scripts/emulators.mjs emulators:exec --headless --only auth,firestore,functions \"playwright test --config playwright.firebase.config.ts\"",
    "firebase:worker": "tsx scripts/firebase-worker.ts",
    "dev:functions": "npm run build:watch -w functions",
    "test:connect": "node scripts/test-connect.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.108.4",
    "clsx": "2.1.1",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "firebase": "13.4.0",
    "jose": "6.2.17",
    "lucide-react": "1.74.0",
    "luxon": "3.7.2",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "ts-fsrs": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "firebase-tools": "15.36.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "undici": "7.30.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
